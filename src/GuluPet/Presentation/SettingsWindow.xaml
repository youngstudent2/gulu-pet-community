<Window x:Class="GuluPet.Presentation.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="问题反馈"
        Width="680"
        Height="540"
        MinWidth="620"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFF7E8"
        FontFamily="Microsoft YaHei UI"
        Icon="/Assets/App.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#FF3F382F" />
        <SolidColorBrush x:Key="MutedInkBrush" Color="#FF766B5D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFF29A4A" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#FFDC8033" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="FeedbackTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFCF7" />
            <Setter Property="BorderBrush" Value="#FFE8D7B7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentPressedBrush}" />
            <Setter Property="SelectionBrush" Value="#66F2A45D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="InputBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                                         Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeedbackButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FF3D2E20" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#FFFFAD61" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="BorderBrush"
                                        Value="#FF8D542A" />
                                <Setter TargetName="ButtonSurface"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                                         Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="ButtonSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeedbackSecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FeedbackButtonStyle}">
            <Setter Property="Background" Value="#FFFFFCF7" />
            <Setter Property="BorderBrush" Value="#FFE1C99D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="36,30,36,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="问题反馈"
                       FontSize="28"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0"
                       Text="告诉我们哪里不对，越具体越容易定位。"
                       FontSize="14"
                       Foreground="{StaticResource MutedInkBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,0"
                Padding="24,22"
                Background="#FFFFFFFF"
                BorderBrush="#FFF0DDB9"
                BorderThickness="1"
                CornerRadius="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="发生了什么"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="FeedbackCountText"
                               Grid.Column="1"
                               Text="0 / 2000"
                               FontSize="12"
                               Foreground="{StaticResource MutedInkBrush}" />
                </Grid>

                <TextBox x:Name="FeedbackTextBox"
                         Grid.Row="1"
                         Height="126"
                         Margin="0,10,0,0"
                         MaxLength="2000"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         SpellCheck.IsEnabled="True"
                         Style="{StaticResource FeedbackTextBoxStyle}"
                         TextChanged="OnFeedbackTextChanged"
                         AutomationProperties.Name="问题描述" />

                <TextBlock Grid.Row="2"
                           Margin="0,12,0,0"
                           Text="发送时会附上近 7 天尚未上报的错误记录。日记、回忆和陪伴记录不会离开这台电脑。"
                           TextWrapping="Wrap"
                           FontSize="12.5"
                           LineHeight="20"
                           Foreground="{StaticResource MutedInkBrush}" />

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="UploadLogsButton"
                            MinWidth="174"
                            Content="发送反馈与排查信息"
                            Style="{StaticResource FeedbackButtonStyle}"
                            Click="OnUploadLogsClicked" />
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            MinWidth="140"
                            Content="打开排查文件夹"
                            Style="{StaticResource FeedbackSecondaryButtonStyle}"
                            Click="OnOpenLogFolderClicked" />
                </Grid>

                <TextBlock x:Name="LogStatusText"
                           Grid.Row="4"
                           Margin="0,14,0,0"
                           MinHeight="20"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedInkBrush}"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>
    </Grid>
</Window>
