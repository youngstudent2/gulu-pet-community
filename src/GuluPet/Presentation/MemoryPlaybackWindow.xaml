<Window x:Class="GuluPet.Presentation.MemoryPlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platform="clr-namespace:GuluPet.Platform"
        Title="回忆"
        Width="528"
        Height="320"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#FFFDF7EA"
        platform:DwmWindowChrome.UseRoundedCorners="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown"
        AutomationProperties.Name="咕噜的回忆播放窗口">
    <Window.Resources>
        <Style x:Key="MemoryButtonFocusVisualStyle"
               TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="1"
                                BorderBrush="#FF75583A"
                                BorderThickness="1"
                                CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MemoryCommandButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="OverridesDefaultStyle"
                    Value="True" />
            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource MemoryButtonFocusVisualStyle}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="InteractionOverlay"
                                        Background="Transparent"
                                        CornerRadius="3" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="InteractionOverlay"
                                        Property="Background"
                                        Value="#12000000" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="InteractionOverlay"
                                        Property="Background"
                                        Value="#24000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MemoryPlaybackActionFocusVisualStyle"
               TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Ellipse x:Name="FocusRing"
                                 Margin="2"
                                 Stroke="#FFF3C46B"
                                 StrokeThickness="2" />
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                                         Value="True">
                                <Setter TargetName="FocusRing"
                                        Property="Stroke"
                                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MemoryPlaybackActionButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="OverridesDefaultStyle"
                    Value="True" />
            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource MemoryPlaybackActionFocusVisualStyle}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Foreground"
                    Value="#FFFDF7EA" />
            <Setter Property="Background"
                    Value="#D9171513" />
            <Setter Property="BorderBrush"
                    Value="#66FFFFFF" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ActionSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="28">
                            <Grid>
                                <Border x:Name="InteractionOverlay"
                                        Background="Transparent"
                                        CornerRadius="28" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="InteractionOverlay"
                                        Property="Background"
                                        Value="#16000000" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="InteractionOverlay"
                                        Property="Background"
                                        Value="#2A000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                                         Value="True">
                                <Setter TargetName="ActionSurface"
                                        Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="ActionSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MemoryRetryButtonFocusVisualStyle"
               TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="2"
                                BorderBrush="#FF75583A"
                                BorderThickness="2"
                                CornerRadius="18" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MemoryRetryButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="OverridesDefaultStyle"
                    Value="True" />
            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource MemoryRetryButtonFocusVisualStyle}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Foreground"
                    Value="#FF594437" />
            <Setter Property="Background"
                    Value="#FFFFE4AF" />
            <Setter Property="BorderBrush"
                    Value="#FFE6BD72" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="RetrySurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <Grid>
                                <Border x:Name="InteractionOverlay"
                                        Background="Transparent"
                                        CornerRadius="17" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="InteractionOverlay"
                                        Property="Background"
                                        Value="#0F000000" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="InteractionOverlay"
                                        Property="Background"
                                        Value="#20000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.48" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                                         Value="True">
                                <Setter TargetName="RetrySurface"
                                        Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="RetrySurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowCard"
            Margin="0"
            Padding="12,0,12,8"
            CornerRadius="0"
            BorderThickness="0"
            Background="#FFFDF7EA">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar"
                  Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"
                           Foreground="#FF443B35"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="回忆" />
                <Button Grid.Column="1"
                        Width="32"
                        Height="28"
                        Margin="6,0,0,0"
                        Padding="0"
                        Style="{StaticResource MemoryCommandButtonStyle}"
                        Click="OnCloseClicked"
                        Cursor="Hand"
                        Content="&#xE8BB;"
                        Foreground="#FF715F52"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        ToolTip="收好回忆"
                        AutomationProperties.Name="收好回忆" />
            </Grid>

            <Border Grid.Row="1"
                    CornerRadius="8"
                    Background="#FFF2E7D6"
                    BorderThickness="0"
                    ClipToBounds="True">
                <Grid>
                    <Grid x:Name="LoadingArtwork"
                          Panel.ZIndex="3"
                          Background="#FFF2E7D6"
                          ClipToBounds="True"
                          IsHitTestVisible="False">
                        <Image x:Name="LoadingArtworkBackdrop"
                               Source="pack://siteoforigin:,,,/Assets/Memories/UI/memory-loading-companion-v1.png"
                               Stretch="UniformToFill"
                               Opacity="0.32"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <BlurEffect Radius="18" />
                            </Image.Effect>
                        </Image>
                        <Border Background="#52FDF7EA" />
                        <Image x:Name="LoadingArtworkForeground"
                               Margin="8"
                               Source="pack://siteoforigin:,,,/Assets/Memories/UI/memory-loading-companion-v1.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="白猫叼来回忆胶片的完整插画" />
                    </Grid>

                    <Grid x:Name="VideoLayer"
                          Background="#FF171513"
                          Visibility="Visible">
                        <MediaElement x:Name="StandbyVideo"
                                      Panel.ZIndex="0"
                                      Opacity="0"
                                      IsHitTestVisible="False"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      Stretch="Uniform"
                                      IsMuted="True"
                                      Volume="0"
                                      MediaOpened="OnMemoryVideoOpened"
                                      MediaEnded="OnMemoryVideoEnded"
                                      MediaFailed="OnMemoryVideoFailed"
                                      AutomationProperties.Name="咕噜的下一段回忆画面" />
                        <MediaElement x:Name="MemoryVideo"
                                      Panel.ZIndex="1"
                                      Opacity="1"
                                      IsHitTestVisible="False"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      Stretch="Uniform"
                                      IsMuted="True"
                                      Volume="0"
                                      MediaOpened="OnMemoryVideoOpened"
                                      MediaEnded="OnMemoryVideoEnded"
                                      MediaFailed="OnMemoryVideoFailed"
                                      AutomationProperties.Name="咕噜的回忆画面" />
                    </Grid>

                    <Border x:Name="FailureOverlay"
                            Panel.ZIndex="4"
                            Margin="16"
                            Padding="16,16,16,62"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            CornerRadius="8"
                            Background="#E6FFF7E9"
                            BorderBrush="#FFE4CDAE"
                            BorderThickness="1"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Assertive">
                        <StackPanel>
                            <TextBlock x:Name="FailureHeadingText"
                                       Text="回忆暂时无法播放"
                                       HorizontalAlignment="Center"
                                       Foreground="#FF614C3D"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="FailureText"
                                       Margin="0,8,0,0"
                                       Foreground="#FF836E5E"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid x:Name="PlaybackActionOverlay"
                          Panel.ZIndex="5"
                          Background="Transparent"
                          Visibility="Collapsed">
                        <Border x:Name="EndedDimmingLayer"
                                Background="#59000000"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        <Button x:Name="PrimaryButton"
                                Width="56"
                                Height="56"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="0"
                                Style="{StaticResource MemoryPlaybackActionButtonStyle}"
                                Click="OnPrimaryClicked"
                                Cursor="Hand"
                                Content="&#xE768;"
                                IsEnabled="False"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="24"
                                Visibility="Collapsed"
                                ToolTip="播放"
                                RenderTransformOrigin="0.5,0.5"
                                AutomationProperties.Name="播放回忆">
                            <Button.RenderTransform>
                                <ScaleTransform x:Name="PrimaryButtonScale"
                                                ScaleX="1"
                                                ScaleY="1" />
                            </Button.RenderTransform>
                        </Button>
                    </Grid>

                    <Border x:Name="ProgressPanel"
                            Panel.ZIndex="6"
                            Margin="10"
                            Padding="10,6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            CornerRadius="6"
                            Background="#EFFFF9EF">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock x:Name="LoadingStatusText"
                                           Margin="0,0,36,0"
                                           Foreground="#FF6E5E52"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Text="检查视频" />
                                <TextBlock x:Name="LoadingPercentText"
                                           HorizontalAlignment="Right"
                                           Foreground="#FF6E5E52"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Text="0%" />
                            </Grid>
                            <ProgressBar x:Name="LoadingProgressBar"
                                         Grid.Row="1"
                                         Height="16"
                                         Margin="0,4,0,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Style="{DynamicResource GuluProgressBarStyle}"
                                         AutomationProperties.Name="回忆加载进度" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
