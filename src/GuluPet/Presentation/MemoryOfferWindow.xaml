<Window x:Class="GuluPet.Presentation.MemoryOfferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="咕噜带来一段回忆"
        Width="440"
        SizeToContent="Height"
        MinHeight="430"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown"
        AutomationProperties.Name="新回忆">
    <Window.Resources>
        <Style x:Key="MemoryOfferButtonFocusVisualStyle"
               TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="2"
                                BorderBrush="#FFFFE1A8"
                                BorderThickness="2"
                                CornerRadius="13" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MemoryOfferButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource MemoryOfferButtonFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Grid>
                                <Border x:Name="InteractionOverlay"
                                        Background="Transparent"
                                        CornerRadius="11" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InteractionOverlay"
                                        Property="Background"
                                        Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InteractionOverlay"
                                        Property="Background"
                                        Value="#18000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.46" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                                         Value="True">
                                <Setter TargetName="ActionSurface"
                                        Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="ActionSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MemoryOfferSecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MemoryOfferButtonStyle}">
            <Setter Property="Foreground" Value="#FFE7E0D5" />
            <Setter Property="Background" Value="#FF4A4641" />
            <Setter Property="BorderBrush" Value="#FF6A635C" />
        </Style>

        <Style x:Key="MemoryOfferPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MemoryOfferButtonStyle}">
            <Setter Property="Foreground" Value="#FF2C2317" />
            <Setter Property="Background" Value="#FFF3C46B" />
            <Setter Property="BorderBrush" Value="#FFFFD990" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border x:Name="OfferSurface"
            CornerRadius="24"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Background="#F52B2927"
            Padding="18"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="OfferSurfaceScale"
                            ScaleX="1"
                            ScaleY="1" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#99000000"
                              BlurRadius="28"
                              ShadowDepth="8"
                              Opacity="0.7" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="238"
                    CornerRadius="16"
                    ClipToBounds="True"
                    Background="#FF171615">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Stretch="UniformToFill"
                           AutomationProperties.Name="回忆的画面" />
                    <Border VerticalAlignment="Bottom"
                            Height="74">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="0,1">
                                <GradientStop Color="#00000000"
                                              Offset="0" />
                                <GradientStop Color="#B8000000"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="12"
                            Padding="10,5"
                            CornerRadius="12"
                            Background="#D9F4C56B">
                        <TextBlock Text="新的回忆"
                                   Foreground="#FF2B2318"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="4,18,4,0">
                <TextBlock x:Name="MemoryTitle"
                           Foreground="#FFFFF8ED"
                           FontSize="24"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="这段时光，我替妈咪找回来了。现在一起看，还是先收好？"
                           Margin="0,7,0,0"
                           Foreground="#FFC8C1B7"
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border x:Name="ErrorPanel"
                    Grid.Row="2"
                    Margin="4,14,4,0"
                    Padding="11,8"
                    CornerRadius="10"
                    Background="#33E8A15E"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorText"
                           Foreground="#FFFFD7AE"
                           FontSize="12"
                           LineHeight="18"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="3"
                  Margin="4,18,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="LaterButton"
                        Grid.Column="0"
                        Click="OnLaterClicked"
                        Content="先收好"
                        Style="{StaticResource MemoryOfferSecondaryButtonStyle}"
                        IsCancel="True"
                        AutomationProperties.Name="先把回忆收好" />
                <Button x:Name="PlayNowButton"
                        Grid.Column="2"
                        Click="OnPlayNowClicked"
                        Content="现在一起看"
                        Style="{StaticResource MemoryOfferPrimaryButtonStyle}"
                        IsDefault="True"
                        AutomationProperties.Name="现在一起看" />
            </Grid>
        </Grid>
    </Border>
</Window>
