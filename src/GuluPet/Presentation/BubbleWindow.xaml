<Window x:Class="GuluPet.Presentation.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="咕噜"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0">
    <Grid x:Name="SkinRoot"
          Margin="14,11,17,17">
        <Border x:Name="BubbleBorder"
                Margin="0,0,14,11"
                MinWidth="108"
                Padding="17,11,48,12"
                CornerRadius="15"
                Background="#FFFFFDF8"
                BorderBrush="#FF68747B"
                BorderThickness="1.25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14"
                                  ShadowDepth="2"
                                  Color="#5C3C3740"
                                  Opacity="0.28" />
            </Border.Effect>
            <Grid>
                <Border Margin="-11,-5,-41,-6"
                        CornerRadius="11"
                        BorderBrush="#66F2B8B0"
                        BorderThickness="1"
                        IsHitTestVisible="False" />
                <TextBlock x:Name="MessageText"
                           Foreground="#FF25272B"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="15"
                           FontWeight="Medium"
                           LineHeight="23"
                           TextWrapping="Wrap"
                           TextAlignment="Left"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Margin="19,-2,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    IsHitTestVisible="False">
            <Ellipse Width="5"
                     Height="5"
                     Fill="#FFF2A9B8" />
            <Border Width="13"
                    Height="5"
                    Margin="4,0,0,0"
                    CornerRadius="2.5"
                    Background="#FFF5D59A" />
            <Ellipse Width="5"
                     Height="5"
                     Margin="4,0,0,0"
                     Fill="#FF9FC6B4" />
        </StackPanel>

        <Path Width="18"
              Height="13"
              Margin="0,0,37,6"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Stretch="Fill"
              Fill="#FFFFFDF8"
              Stroke="#FF68747B"
              StrokeThickness="1.25"
              Data="M 0,0 L 18,0 L 5,13 Z"
              IsHitTestVisible="False" />

        <Border x:Name="GuluHeadBadge"
                Width="42"
                Height="42"
                Margin="0,0,-1,-3"
                Padding="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#FFFFFDF8"
                BorderBrush="#FF68747B"
                BorderThickness="1.25"
                CornerRadius="21"
                IsHitTestVisible="False">
            <Border x:Name="GuluHeadImage"
                    ClipToBounds="True"
                    CornerRadius="18"
                    Background="#FFF3ECE5" />
        </Border>
    </Grid>
</Window>
