<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="GuluScrollTrackBrush"
                     Color="#FFF4EACF" />
    <SolidColorBrush x:Key="GuluScrollTrackHoverBrush"
                     Color="#FFEFE0B4" />
    <SolidColorBrush x:Key="GuluScrollThumbBrush"
                     Color="#FFFFF7DD" />
    <SolidColorBrush x:Key="GuluScrollThumbBorderBrush"
                     Color="#FFE7B94E" />
    <SolidColorBrush x:Key="GuluScrollThumbHoverBrush"
                     Color="#FFFFF1BD" />
    <SolidColorBrush x:Key="GuluScrollThumbPressedBrush"
                     Color="#FFFFE08A" />

    <Style x:Key="GuluScrollPageButtonStyle"
           TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GuluVerticalScrollThumbStyle"
           TargetType="{x:Type Thumb}">
        <Setter Property="MinHeight"
                Value="36" />
        <Setter Property="Background"
                Value="{StaticResource GuluScrollThumbBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource GuluScrollThumbBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Margin="1,1"
                          SnapsToDevicePixels="True">
                        <Border x:Name="ThumbShell"
                                Width="16"
                                HorizontalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" />
                        <Image x:Name="PawThumbImage"
                               Width="14"
                               Height="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://siteoforigin:,,,/Assets/UI/paw-scroll.png"
                               Stretch="Uniform" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ThumbShell"
                                    Property="Background"
                                    Value="{StaticResource GuluScrollThumbHoverBrush}" />
                            <Setter TargetName="PawThumbImage"
                                    Property="Opacity"
                                    Value="0.94" />
                        </Trigger>
                        <Trigger Property="IsDragging"
                                 Value="True">
                            <Setter TargetName="ThumbShell"
                                    Property="Background"
                                    Value="{StaticResource GuluScrollThumbPressedBrush}" />
                            <Setter TargetName="ThumbShell"
                                    Property="BorderBrush"
                                    Value="#FFCE9230" />
                            <Setter TargetName="PawThumbImage"
                                    Property="Opacity"
                                    Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                                     Value="True">
                            <Setter TargetName="ThumbShell"
                                    Property="Background"
                                    Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            <Setter TargetName="ThumbShell"
                                    Property="BorderBrush"
                                    Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                            <Setter TargetName="PawThumbImage"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GuluHorizontalScrollThumbStyle"
           TargetType="{x:Type Thumb}"
           BasedOn="{StaticResource GuluVerticalScrollThumbStyle}">
        <Setter Property="MinWidth"
                Value="36" />
        <Setter Property="MinHeight"
                Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Margin="1,1"
                          SnapsToDevicePixels="True">
                        <Border x:Name="ThumbShell"
                                Height="16"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" />
                        <Image x:Name="PawThumbImage"
                               Width="14"
                               Height="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://siteoforigin:,,,/Assets/UI/paw-scroll.png"
                               Stretch="Uniform" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ThumbShell"
                                    Property="Background"
                                    Value="{StaticResource GuluScrollThumbHoverBrush}" />
                            <Setter TargetName="PawThumbImage"
                                    Property="Opacity"
                                    Value="0.94" />
                        </Trigger>
                        <Trigger Property="IsDragging"
                                 Value="True">
                            <Setter TargetName="ThumbShell"
                                    Property="Background"
                                    Value="{StaticResource GuluScrollThumbPressedBrush}" />
                            <Setter TargetName="ThumbShell"
                                    Property="BorderBrush"
                                    Value="#FFCE9230" />
                            <Setter TargetName="PawThumbImage"
                                    Property="Opacity"
                                    Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                                     Value="True">
                            <Setter TargetName="ThumbShell"
                                    Property="Background"
                                    Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            <Setter TargetName="ThumbShell"
                                    Property="BorderBrush"
                                    Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                            <Setter TargetName="PawThumbImage"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="GuluVerticalScrollBarTemplate"
                     TargetType="{x:Type ScrollBar}">
        <Grid Width="{TemplateBinding Width}"
              Background="Transparent"
              SnapsToDevicePixels="True">
            <Border x:Name="TrackShell"
                    Width="8"
                    Margin="0,2"
                    HorizontalAlignment="Center"
                    Background="{StaticResource GuluScrollTrackBrush}"
                    BorderBrush="#FFE7D9AD"
                    BorderThickness="1"
                    CornerRadius="4" />
            <Track x:Name="PART_Track"
                   Margin="0,3"
                   Focusable="False"
                   IsDirectionReversed="True"
                   Maximum="{TemplateBinding Maximum}"
                   Minimum="{TemplateBinding Minimum}"
                   Orientation="Vertical"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource GuluScrollPageButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource GuluVerticalScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource GuluScrollPageButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter TargetName="TrackShell"
                        Property="Background"
                        Value="{StaticResource GuluScrollTrackHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin"
                     Value="True">
                <Setter TargetName="TrackShell"
                        Property="BorderBrush"
                        Value="#FF2D6F73" />
            </Trigger>
            <Trigger Property="IsEnabled"
                     Value="False">
                <Setter Property="Opacity"
                        Value="0.42" />
            </Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                         Value="True">
                <Setter TargetName="TrackShell"
                        Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter TargetName="TrackShell"
                        Property="BorderBrush"
                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="GuluHorizontalScrollBarTemplate"
                     TargetType="{x:Type ScrollBar}">
        <Grid Height="{TemplateBinding Height}"
              Background="Transparent"
              SnapsToDevicePixels="True">
            <Border x:Name="TrackShell"
                    Height="8"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Background="{StaticResource GuluScrollTrackBrush}"
                    BorderBrush="#FFE7D9AD"
                    BorderThickness="1"
                    CornerRadius="4" />
            <Track x:Name="PART_Track"
                   Margin="3,0"
                   Focusable="False"
                   IsDirectionReversed="False"
                   Maximum="{TemplateBinding Maximum}"
                   Minimum="{TemplateBinding Minimum}"
                   Orientation="Horizontal"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource GuluScrollPageButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource GuluHorizontalScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource GuluScrollPageButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter TargetName="TrackShell"
                        Property="Background"
                        Value="{StaticResource GuluScrollTrackHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin"
                     Value="True">
                <Setter TargetName="TrackShell"
                        Property="BorderBrush"
                        Value="#FF2D6F73" />
            </Trigger>
            <Trigger Property="IsEnabled"
                     Value="False">
                <Setter Property="Opacity"
                        Value="0.42" />
            </Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                         Value="True">
                <Setter TargetName="TrackShell"
                        Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter TargetName="TrackShell"
                        Property="BorderBrush"
                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="GuluScrollBarStyle"
           TargetType="{x:Type ScrollBar}">
        <Setter Property="Width"
                Value="18" />
        <Setter Property="Height"
                Value="Auto" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="Template"
                Value="{StaticResource GuluVerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation"
                     Value="Horizontal">
                <Setter Property="Width"
                        Value="Auto" />
                <Setter Property="Height"
                        Value="18" />
                <Setter Property="Template"
                        Value="{StaticResource GuluHorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollBar}"
           BasedOn="{StaticResource GuluScrollBarStyle}" />

    <Style x:Key="GuluProgressBarStyle"
           TargetType="{x:Type ProgressBar}">
        <Setter Property="Height"
                Value="16" />
        <Setter Property="MinWidth"
                Value="40" />
        <Setter Property="Background"
                Value="#FFE9DDCE" />
        <Setter Property="Foreground"
                Value="#FF607863" />
        <Setter Property="BorderBrush"
                Value="#FFD8C6AD" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid ClipToBounds="True"
                          SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" />
                        <Border x:Name="PART_Indicator"
                                Margin="2"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Image x:Name="PawProgressMarker"
                                   Width="12"
                                   Height="12"
                                   Margin="2,0,1,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="pack://siteoforigin:,,,/Assets/UI/paw-scroll.png"
                                   Stretch="Uniform" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="0.42" />
                        </Trigger>
                        <Trigger Property="IsIndeterminate"
                                 Value="True">
                            <Setter TargetName="PART_Indicator"
                                    Property="HorizontalAlignment"
                                    Value="Stretch" />
                            <Setter TargetName="PART_Indicator"
                                    Property="Opacity"
                                    Value="0.7" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                                     Value="True">
                            <Setter TargetName="PART_Track"
                                    Property="Background"
                                    Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                            <Setter TargetName="PART_Track"
                                    Property="BorderBrush"
                                    Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                            <Setter TargetName="PART_Indicator"
                                    Property="Background"
                                    Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            <Setter TargetName="PawProgressMarker"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ProgressBar}"
           BasedOn="{StaticResource GuluProgressBarStyle}" />
</ResourceDictionary>
