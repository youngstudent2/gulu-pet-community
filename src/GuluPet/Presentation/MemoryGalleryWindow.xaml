<Window x:Class="GuluPet.Presentation.MemoryGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="咕噜的回忆"
        Width="860"
        Height="720"
        MinWidth="720"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8F4"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="咕噜的回忆">
    <Window.Resources>
        <Style x:Key="MemoryCardButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Margin"
                    Value="8" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="MinHeight"
                    Value="352" />
            <Setter Property="Background"
                    Value="#FFFFFFFF" />
            <Setter Property="BorderBrush"
                    Value="#FFE9DDD6" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type Control}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border Margin="3"
                                            BorderBrush="#FF8B6B5F"
                                            BorderThickness="2"
                                            CornerRadius="15" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Card"
                                Padding="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="#FFFFFBF8" />
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="#FFF1BBA7" />
                                <Setter TargetName="Card"
                                        Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14"
                                                          ShadowDepth="3"
                                                          Direction="270"
                                                          Color="#443C2D28"
                                                          Opacity="0.2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="#FFFFF1EA" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Card"
                                        Property="Opacity"
                                        Value="0.72" />
                                <Setter Property="Cursor"
                                        Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MemoryCardTemplate">
            <Button Style="{StaticResource MemoryCardButtonStyle}"
                    Tag="{Binding}"
                    IsEnabled="{Binding Entry.IsEnabled}"
                    AutomationProperties.Name="{Binding Entry.AutomationName}"
                    AutomationProperties.HelpText="{Binding Entry.AutomationHelpText}"
                    Click="OnMemoryClicked">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="210" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#FFF3ECE7"
                            BorderBrush="#FFE8DCD5"
                            BorderThickness="1"
                            CornerRadius="12"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Thumbnail}"
                                   Stretch="UniformToFill"
                                   Opacity="0.18"
                                   RenderOptions.BitmapScalingMode="LowQuality">
                                <Image.Effect>
                                    <BlurEffect Radius="18" />
                                </Image.Effect>
                            </Image>
                            <Border Background="#66F3ECE7" />
                            <Image Source="{Binding Thumbnail}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="{Binding Entry.Title}" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding MissingThumbnailVisibility}">
                                <TextBlock Text="ฅ^•ﻌ•^ฅ"
                                           HorizontalAlignment="Center"
                                           FontSize="25"
                                           Foreground="#FF9C8378" />
                                <TextBlock Text="这张照片暂时躲起来了"
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           Foreground="#FF8A756C" />
                            </StackPanel>
                            <Border Margin="10"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    CornerRadius="12">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background"
                                                Value="#E8E9F1EA" />
                                        <Setter Property="BorderBrush"
                                                Value="#FFBBCDBD" />
                                        <Setter Property="BorderThickness"
                                                Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Entry.IsPending}"
                                                         Value="True">
                                                <Setter Property="Background"
                                                        Value="#F2FFE1D5" />
                                                <Setter Property="BorderBrush"
                                                        Value="#FFF0B39B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Entry.StatusLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground"
                                                    Value="#FF5C765F" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Entry.IsPending}"
                                                             Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="#FFA7553F" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          Margin="4,12,4,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Entry.Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FF493C36"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,7,0,10"
                                   MaxHeight="40"
                                   Text="{Binding Entry.Description}"
                                   FontSize="11.5"
                                   LineHeight="18"
                                   Foreground="#FF7D6A62"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Entry.SequenceLabel}"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#FF9A857B" />
                            <Border Grid.Column="1"
                                    Padding="15,7"
                                    CornerRadius="14">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background"
                                                Value="#FFE8F0E9" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Entry.IsPending}"
                                                         Value="True">
                                                <Setter Property="Background"
                                                        Value="#FFFFD8C7" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Entry.HasFailed}"
                                                         Value="True">
                                                <Setter Property="Background"
                                                        Value="#FFFFE2D7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Entry.ActionLabel}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FF6D5148" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="22,18"
                CornerRadius="22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="#FFFFDCCF"
                                  Offset="0" />
                    <GradientStop Color="#FFFFF0D5"
                                  Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="咕噜的回忆"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#FF4D403A" />
                    <TextBlock Margin="0,7,0,0"
                               Text="一起经历过的小事，都被咕噜好好收在这里。"
                               FontSize="13"
                               Foreground="#FF796A62" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        Background="#CCFFFFFF"
                        BorderBrush="#88E7CABD"
                        BorderThickness="1"
                        CornerRadius="18">
                    <TextBlock x:Name="SummaryText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FF754F42" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#66FFFFFF"
                BorderBrush="#FFE8DBD3"
                BorderThickness="1"
                CornerRadius="17"
                Padding="6">
            <Grid>
                <ScrollViewer x:Name="GalleryScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly">
                    <ItemsControl x:Name="MemoryItems"
                                  Margin="2,2,2,12"
                                  ItemTemplate="{StaticResource MemoryCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <primitives:UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState"
                            Width="420"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Width="112"
                            Height="112"
                            HorizontalAlignment="Center"
                            Background="#FFFFE8DD"
                            BorderBrush="#FFF0C6B5"
                            BorderThickness="1"
                            CornerRadius="56">
                        <TextBlock Text="ฅ^•ﻌ•^ฅ"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   Foreground="#FF7A594D" />
                    </Border>
                    <TextBlock Text="第一段回忆还在路上"
                               Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#FF4D403A" />
                    <TextBlock Text="和咕噜多待一会儿，这里会慢慢装满你们的小故事。"
                               Margin="0,7,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="12.5"
                               Foreground="#FF7D6A62"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="5,12,5,0"
                   HorizontalAlignment="Right"
                   Foreground="#FF6F5B52"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
